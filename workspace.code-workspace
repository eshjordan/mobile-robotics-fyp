{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"python.autoComplete.extraPaths": [
			"/opt/ros/jazzy/lib/python3.12/site-packages"
		],
		"python.analysis.extraPaths": [
			"/opt/ros/jazzy/lib/python3.12/site-packages"
		],
		"editor.formatOnSave": true,
		"editor.formatOnType": true,
		"clangd.arguments": [
			"--background-index",
			"--suggest-missing-includes",
			"--clang-tidy",
			"-j=16"
		],
		"cSpell.enabled": false,
		"files.associations": {
			"compare": "cpp",
			"cstdint": "cpp"
		},
		"flake8.args": [
			"--ignore=C417,CNL100,D100,D101,D102,D103,D107,D202,D205,D400,D401,E226,E501,I100,I101,I201,Q000,W503"
		],
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"type": "gdb",
				"request": "launch",
				"name": "Launch cpp_epuck_unit_test",
				"target": "./build/cpp_epuck/cpp_epuck_unit_test",
				"cwd": "${workspaceRoot}",
				"valuesFormatting": "parseText"
			}
		]
	}
}